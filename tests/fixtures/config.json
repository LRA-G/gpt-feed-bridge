    "initial_backfill_per_source": 1,
    "request_timeout_seconds": 5
  },
  "paths": {
    "state": "work/state.json",
    "output": "work/feed.xml",
    "status": "work/status.json"
  },
  "interests": ["數位生產力", "長期知識保存"],
  "sources": [
    {
      "name": "測試來源",
      "url": "sample-rss.xml",
      "enabled": true
    }
  ]
