{
  "feed": {
    "title": "GPT Feed Bridge 測試",
    "description": "模擬輸出",
    "language": "zh-TW",
    "public_url": "https://example.test/feed.xml",
    "home_url": "https://example.test/"
  },
  "openai": {
    "model": "gpt-5.6-luna",
    "reasoning_effort": "none",
